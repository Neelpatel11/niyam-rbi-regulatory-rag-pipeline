# Copy to .env and fill in. Never commit .env.

# Generation (default provider is Anthropic)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# anthropic | openai | gemini | extractive (offline stand-in)
NIYAM_LLM_PROVIDER=anthropic
NIYAM_LLM_MODEL=claude-opus-5-5
# low | medium | high
NIYAM_LLM_EFFORT=medium
# NIYAM_REWRITE_MODEL=                # optional separate model for query rewriting
# NIYAM_JUDGE_MODEL=                  # optional separate model for the eval judge

# Database (docker compose sets this for the api container)
NIYAM_DATABASE_URL=postgresql://niyam:niyam@localhost:5432/niyam

# Retrieval
# fastembed | openai | gemini
NIYAM_EMBEDDING_PROVIDER=fastembed
NIYAM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NIYAM_CHUNK_SET=structure-v1
NIYAM_RERANK_ENABLED=true
NIYAM_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# tune with `niyam eval tune`
NIYAM_REFUSAL_THRESHOLD=0.15

# API hardening for public deployments
# NIYAM_API_KEYS=["change-me"]
NIYAM_RATE_LIMIT_PER_MINUTE=30
NIYAM_CORS_ORIGINS=["http://localhost:3000"]

# Optional tracing (Langfuse reads LANGFUSE_* itself)
NIYAM_LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: extra model prices (YAML) for providers not in the built-in table
# NIYAM_PRICES_FILE=prices.yaml
